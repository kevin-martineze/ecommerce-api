# ---------------------------------------------------------------------------
# Entorno
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=v1

# ---------------------------------------------------------------------------
# Base de datos — DOS cadenas, a propósito
#
# DATABASE_URL  Conexión de RUNTIME. Usa el rol `tienda_app`, que NO es dueño
#               de las tablas y NO tiene BYPASSRLS. Es lo que hace que las
#               políticas de RLS realmente se apliquen: el dueño de una tabla
#               se las salta por defecto, así que conectarse como `postgres`
#               desactivaría en silencio toda la red de seguridad multi-tienda.
#
# DIRECT_URL    Conexión de MIGRACIONES. Rol dueño, conexión directa sin
#               pooler. Prisma la lee desde prisma.config.ts. Mezclarlas hace
#               que `migrate` falle con errores confusos sobre sentencias
#               preparadas cuando hay un pooler en medio.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://tienda_app:tienda_app@localhost:5432/tienda
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/tienda

# ---------------------------------------------------------------------------
# Autenticación (fase 3)
# ---------------------------------------------------------------------------
JWT_SECRET=cambia-esto-en-produccion-minimo-32-caracteres
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECRET=cambia-esto-tambien-minimo-32-caracteres

# ---------------------------------------------------------------------------
# CORS
#
# El navegador NUNCA habla con este API: el frontend SvelteKit carga todo desde
# `+page.server.ts`, servidor contra servidor. La lista se deja acotada de
# todos modos para que un origen inesperado sea un fallo visible y no un
# agujero silencioso.
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Fotos (fase 8)
#
# local  Disco. La API las sirve bajo MEDIA_PUBLIC_URL (= <API>/media).
#        Sirve para desarrollo y para un solo servidor.
# s3     Cualquier bucket compatible: R2, S3, MinIO. Obligatorio con varias
#        instancias o un CDN delante. Las fotos se sirven desde S3_PUBLIC_URL,
#        nunca a través de la API.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
MEDIA_DIR=media
MEDIA_PUBLIC_URL=http://127.0.0.1:3000/media

# Solo con STORAGE_DRIVER=s3. Producción: Cloudflare R2 (paso a paso en
# docs/DEPLOY.md § 1). Comprueba la configuración con `pnpm storage:check`.
# MinIO local: endpoint http://127.0.0.1:9000, S3_FORCE_PATH_STYLE=true.
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=tienda-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://media.mitienda.com
# S3_FORCE_PATH_STYLE=false

# ---------------------------------------------------------------------------
# Correo (recuperar contraseña, invitaciones)
#
# log   El mensaje se escribe en el log de la API: el enlace se copia de ahí.
# smtp  Cualquier proveedor SMTP (Resend, SES, Postmark…).
#
# FRONTEND_URL es la base de los enlaces que viajan por correo. Sale del
# entorno, nunca del Host de la petición.
# ---------------------------------------------------------------------------
MAIL_DRIVER=log
# SMTP_URL=smtp://usuario:clave@smtp.proveedor.com:587
MAIL_FROM="Tienda <no-responder@mitienda.com>"
FRONTEND_URL=http://localhost:5173
