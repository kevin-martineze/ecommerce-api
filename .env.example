# ---------------------------------------------------------------------------
# Entorno
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=v1

# ---------------------------------------------------------------------------
# Base de datos — DOS cadenas, a propósito
#
# DATABASE_URL  Conexión de RUNTIME. Usa el rol `tienda_app`, que NO es dueño
#               de las tablas y NO tiene BYPASSRLS. Es lo que hace que las
#               políticas de RLS realmente se apliquen: el dueño de una tabla
#               se las salta por defecto, así que conectarse como `postgres`
#               desactivaría en silencio toda la red de seguridad multi-tienda.
#
# DIRECT_URL    Conexión de MIGRACIONES. Rol dueño, conexión directa sin
#               pooler. Prisma la lee desde prisma.config.ts. Mezclarlas hace
#               que `migrate` falle con errores confusos sobre sentencias
#               preparadas cuando hay un pooler en medio.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://tienda_app:tienda_app@localhost:5432/tienda
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/tienda

# ---------------------------------------------------------------------------
# Autenticación (fase 3)
# ---------------------------------------------------------------------------
JWT_SECRET=cambia-esto-en-produccion-minimo-32-caracteres
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECRET=cambia-esto-tambien-minimo-32-caracteres

# ---------------------------------------------------------------------------
# CORS
#
# El navegador NUNCA habla con este API: el frontend SvelteKit carga todo desde
# `+page.server.ts`, servidor contra servidor. La lista se deja acotada de
# todos modos para que un origen inesperado sea un fallo visible y no un
# agujero silencioso.
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
